  nodes:
  - id: greeting_001
    speakerId: merchant-daran
    text: Looking to trade, traveler? Or are you looking for work?
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 1
    emotionalDeliveryId: 
    gestureId: nod
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Show me your wares.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Any work available?
      nextNodeId: work_001
      action: 0
      conditionId: 
    - text: Tell me about this place.
      nextNodeId: place_001
      action: 0
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: trade_offer_001
    speakerId: merchant-daran
    text: Put your goods on the counter. Let's see what they're worth.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: nod
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll look around.
      nextNodeId: trade_offer_001
      action: 0
      conditionId: 
    - text: That's all for now.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_001
    speakerId: merchant-daran
    text: A caravan vanished near the old toll station. I might pay for a useful
      answer.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 3
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 2
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Back to trading.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: place_001
    speakerId: merchant-daran
    text: People call this a settlement. The wind calls it a place to leave.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Show me your wares.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: trade_complete
    speakerId: merchant-daran
    text: Fair enough. We've got ourselves a deal.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 1
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Keep trading.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: farewell_001
    speakerId: merchant-daran
    text: Stay clear of the dust. It doesn't care who you are.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 1
    nextNodeId: 
    responses: []
    generatedFingerprint: 
    mouthEnvelope: []
  - id: insufficient_funds_001
    speakerId: merchant-daran
    text: Your purse is lighter than your ambition.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 2
    emotionalDeliveryId: 
