MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b29b4dcb42bdd5840a7f570c1dd0e8fe, type: 3}
  m_Name: DaranDialogue
  m_EditorClassIdentifier: Assembly-CSharp::Zandea.FriendlyNPC.DialogueDefinition
  npcId: merchant-daran
  defaultVoice: {fileID: 11400000, guid: 134a3782190060145912745c02e14899, type: 2}
  entryNodeId: greeting_001
  nodes:
  - id: greeting_001
    speakerId: merchant-daran
    text: Looking to trade, traveler? Or are you looking for work?
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 1
    emotionalDeliveryId: 
    gestureId: nod
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Show me your wares.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Any work available?
      nextNodeId: work_001
      action: 0
      conditionId: 
    - text: Tell me about this place.
      nextNodeId: place_001
      action: 0
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: trade_offer_001
    speakerId: merchant-daran
    text: Go on, have a look. Anything on the counter is for sale. Well, almost anything.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: present
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll look around.
      nextNodeId: 
      action: 4
      conditionId: 
    - text: That's all for now.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_001
    speakerId: merchant-daran
    text: A caravan vanished near the old toll station. I might pay for a useful
      answer.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 3
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 2
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Back to trading.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: place_001
    speakerId: merchant-daran
    text: People call this a settlement. The wind calls it a place to leave.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Show me your wares.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: trade_complete
    speakerId: merchant-daran
    text: Pleasure doing business with you. A fair trade, more or less.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 1
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Keep trading.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: farewell_001
    speakerId: merchant-daran
    text: Safe travels! And try not to die before you come back.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 1
    nextNodeId: 
    responses: []
    generatedFingerprint: 
    mouthEnvelope: []
  - id: insufficient_funds_001
    speakerId: merchant-daran
    text: You're short on Zeks, friend. Afraid good intentions don't pay the bills.
      Put something back.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 2
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Adjust the offer.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: merchant_lacks_funds_001
    speakerId: merchant-daran
    text: I'd buy it, if I had the Zeks to spare.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 3
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Adjust the offer.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: item_rejected_001
    speakerId: merchant-daran
    text: That won't fetch anything here.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 2
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Adjust the offer.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: transaction_ready_001
    speakerId: merchant-daran
    text: Fair enough. Come on, let's shake on it.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 1
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Adjust the offer.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: trade_cancelled_001
    speakerId: merchant-daran
    text: Changed your mind? Happens more than you'd think.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Adjust the offer.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: greeting_002
    speakerId: merchant-daran
    text: Ah, a customer! Come closer. Let's see what you need.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 1
    emotionalDeliveryId: 
    gestureId: nod
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Show me your wares.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    - text: Any work available?
      nextNodeId: work_001
      action: 0
      conditionId: 
    - text: Tell me about this place.
      nextNodeId: place_001
      action: 0
      conditionId: 
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: stock_warning_001
    speakerId: merchant-daran
    text: Don't walk off with my stock, traveler.
    voiceOverride: {fileID: 11400000, guid: 614953ac996354b41b2b79b6b6a77617, type: 2}
    audio: {fileID: 0}
    expression: 2
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses: []
    generatedFingerprint: 
    mouthEnvelope: []
  - id: stock_stolen_001
    speakerId: merchant-daran
    text: That's mine. Bring it back.
    voiceOverride: {fileID: 11400000, guid: 614953ac996354b41b2b79b6b6a77617, type: 2}
    audio: {fileID: 0}
    expression: 2
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses: []
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_offer
    speakerId: merchant-daran
    text: Looking for work? Got three barrels I need moved from the warehouse to
      my stall. Ten Zeks each. Break one, and you owe me ten. Simple enough?
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll do it.
      nextNodeId: work_accept
      action: 5
      conditionId: 
    - text: Where's the warehouse?
      nextNodeId: work_location
      action: 0
      conditionId: 
    - text: What happens if I break one?
      nextNodeId: work_breakage
      action: 0
      conditionId: 
    - text: Not interested.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_location
    speakerId: merchant-daran
    text: Storage shed, just across the settlement. Three barrels outside. Bring
      them here.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll do it.
      nextNodeId: work_accept
      action: 5
      conditionId: 
    - text: Back.
      nextNodeId: work_offer
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_breakage
    speakerId: merchant-daran
    text: You don't get paid for a broken barrel, and I charge ten Zeks for the damage.
      Those barrels aren't free.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll do it.
      nextNodeId: work_accept
      action: 5
      conditionId: 
    - text: Back.
      nextNodeId: work_offer
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_accept
    speakerId: merchant-daran
    text: Good. Get moving, then. And try not to smash anything.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_progress
    speakerId: merchant-daran
    text: Those barrels won't move themselves, you know.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll get to it.
      nextNodeId: daran_job_goodbye
      action: 0
      conditionId: 
    - text: I've finished.
      nextNodeId: daran_job_incomplete
      action: 0
      conditionId: 
    - text: I quit.
      nextNodeId: daran_job_abandon
      action: 7
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_ready
    speakerId: merchant-daran
    text: All done, then? Let's see what you've earned.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Settle up.
      nextNodeId: work_result
      action: 6
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_result
    speakerId: merchant-daran
    text: A deal's a deal. Take what you've earned, or put your purse on the counter
      if you owe me.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_finished
    speakerId: merchant-daran
    text: Not bad for a day's work. Come back if you need a few more Zeks.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Show me your wares.
      nextNodeId: trade_offer_001
      action: 1
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: work_abandoned
    speakerId: merchant-daran
    text: Suit yourself. But don't make a habit of wasting my time.
    voiceOverride: {fileID: 0}
    audio: {fileID: 0}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: Goodbye.
      nextNodeId: farewell_001
      action: 0
      conditionId: 
    generatedFingerprint: 
    mouthEnvelope: []
  - id: daran_job_offer
    speakerId: merchant-daran
    text: Looking for work, are you? Well, I've got three barrels that need hauling
      from the storage shed to my stall. Ten Zeks apiece. Easy money, if you've got
      a decent pair of arms.
    voiceOverride: {fileID: 0}
    audio: {fileID: 8300000, guid: af1d7b7032c94ea488b3fbfdf3bf8f81, type: 3}
    expression: 0
    emotionalDeliveryId: 
    gestureId: 
    conditionId: 
    onEnter: 0
    endOnComplete: 0
    nextNodeId: 
    responses:
    - text: I'll do it.
      nextNodeId: daran_job_accept
      action: 5
      conditionId: 
    - text: How much does it pay?
      nextNodeId: daran_job_payment
      action: 0
      conditionId: 
    - text: Where are the barrels?
      nextNodeId: daran_job_directions
      action: 0
      conditionId: 
    - text: Not interested.
      nextNodeId: daran_job_decline
      action: 0
      conditionId: 
    generatedFingerprint: 
